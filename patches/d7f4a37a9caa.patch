From d7f4a37a9caa3f31fe6ee393b8d2eb34876cba33 Mon Sep 17 00:00:00 2001
From: Miguel Sobral Teixeira <mest2011mest@gmail.com>
Date: Sun, 15 Nov 2026 15:13:03 -0300
Subject: [PATCH] ASoC: max98927: add the chip type to the match data

Put a chip type in the OF, I2C and ACPI match tables and read it with
i2c_get_match_data(), so that the driver can tell variants apart. The
enum starts at 1, so a missing match is not mistaken for a valid type.

No functional change.

Signed-off-by: Miguel Sobral Teixeira <mest2011mest@gmail.com>
---
 sound/soc/codecs/max98927.c | 11 ++++++++---
 sound/soc/codecs/max98927.h |  5 +++++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/sound/soc/codecs/max98927.c b/sound/soc/codecs/max98927.c
index 65e6fdb30eec8d..d02d37aa11b91f 100644
--- a/sound/soc/codecs/max98927.c
+++ b/sound/soc/codecs/max98927.c
@@ -809,6 +809,11 @@ static int max98927_i2c_probe(struct i2c_client *i2c)
 	}
 	i2c_set_clientdata(i2c, max98927);
 
+	max98927->type = (uintptr_t)i2c_get_match_data(i2c);
+	if (!max98927->type)
+		return dev_err_probe(&i2c->dev, -EINVAL,
+				     "Unknown device type\n");
+
 	/* update interleave mode info */
 	if (of_property_read_bool(i2c->dev.of_node, "maxim,interleave-mode")) {
 		max98927->interleave_mode = true;
@@ -873,7 +878,7 @@ static void max98927_i2c_remove(struct i2c_client *i2c)
 }
 
 static const struct i2c_device_id max98927_i2c_id[] = {
-	{ .name = "max98927" },
+	{ .name = "max98927", .driver_data = MAX98927 },
 	{ }
 };
 
@@ -881,7 +886,7 @@ MODULE_DEVICE_TABLE(i2c, max98927_i2c_id);
 
 #if defined(CONFIG_OF)
 static const struct of_device_id max98927_of_match[] = {
-	{ .compatible = "maxim,max98927", },
+	{ .compatible = "maxim,max98927", .data = (void *)MAX98927 },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, max98927_of_match);
@@ -889,7 +894,7 @@ MODULE_DEVICE_TABLE(of, max98927_of_match);
 
 #ifdef CONFIG_ACPI
 static const struct acpi_device_id max98927_acpi_match[] = {
-	{ "MX98927", 0 },
+	{ "MX98927", MAX98927 },
 	{},
 };
 MODULE_DEVICE_TABLE(acpi, max98927_acpi_match);
diff --git a/sound/soc/codecs/max98927.h b/sound/soc/codecs/max98927.h
index 2353910f5f1753..ca0f9d9f00b1a9 100644
--- a/sound/soc/codecs/max98927.h
+++ b/sound/soc/codecs/max98927.h
@@ -251,8 +251,13 @@
 /* MAX98927_R00FF_GLOBAL_SHDN */
 #define MAX98927_GLOBAL_EN_MASK (0x1 << 0)
 
+enum max98927_type {
+	MAX98927 = 1,
+};
+
 struct max98927_priv {
 	struct regmap *regmap;
+	enum max98927_type type;
 	struct snd_soc_component *component;
 	struct max98927_pdata *pdata;
 	struct gpio_desc *reset_gpio; 
